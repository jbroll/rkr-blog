#!/usr/bin/env bash
# Unit job (sci-tiered tier-2 pushes this as <wt>/ci/test, in parallel with
# ci/e2e). Runs node unit tests with c8 per-file thresholds, then the
# admin/site bundle build + bundle-size ratchet. No Playwright here — E2E and
# its coverage live in ci/e2e.
set -euo pipefail
cd "$(dirname "$0")/.."

npm install

npm run --silent build:packages

npm run test:coverage

npm run build:admin
npm run build:site
node --no-warnings=ExperimentalWarning --experimental-strip-types \
  scripts/check-bundle-size.ts
