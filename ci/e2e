#!/usr/bin/env bash
# E2E job (sci-tiered tier-2 pushes this as <wt>/ci/e2e, in parallel with
# ci/test). Builds the bundles, runs Playwright (emitting coverage/e2e/lcov.info
# for the union ratchet), then the bespoke admin/site E2E-coverage check.
set -euo pipefail
cd "$(dirname "$0")/.."

npm install
npx playwright install chromium

npm run --silent build:packages
npm run --silent build:admin
npm run --silent build:site
npm run test:e2e

admin_site_files=$(find src/admin src/site -name '*.ts' | tr '\n' ' ')
# shellcheck disable=SC2086
node --no-warnings=ExperimentalWarning --experimental-strip-types \
  scripts/check-e2e-coverage.ts $admin_site_files
