#!/usr/bin/env bash
# E2E job (sci-tiered tier-2 pushes this as <wt>/ci/e2e, in parallel with
# ci/test). Builds the bundles and runs Playwright, emitting
# coverage/e2e/lcov.info which sci-tiered scp's for the union coverage ratchet.
# (The bespoke check-e2e-coverage.ts was removed in b644581 when this repo
# migrated coverage gating to org-hooks; don't reintroduce it.)
set -euo pipefail
cd "$(dirname "$0")/.."

# A Playwright run that gets SIGKILLed (a hang the CI runner kills, or a
# fail-fast kill from the sibling unit job) orphans its webServer child —
# e2e/server-runner.ts keeps LISTENing on :3789 long after the worktree is
# gone. The NEXT e2e run then finds a healthy /health on that stale server,
# runs against its deleted site root, and hangs indefinitely. Free the port
# before starting (clears any leak from a prior run) and on exit (so this run
# doesn't leak when it ends cleanly).
free_e2e_port() { pkill -9 -f 'e2e/server-runner' 2>/dev/null || true; }
free_e2e_port
trap free_e2e_port EXIT

npm install
npx playwright install chromium

if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
  echo "ffmpeg and ffprobe are required for video e2e specs" >&2
  exit 1
fi

npm run --silent build:packages
npm run --silent build:admin
npm run --silent build:site
npm run --silent build:pwa
npm run test:e2e
