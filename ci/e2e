#!/usr/bin/env bash
# E2E job (sci-tiered tier-2 pushes this as <wt>/ci/e2e, in parallel with
# ci/test). Builds the bundles and runs Playwright, emitting
# coverage/e2e/lcov.info which sci-tiered scp's for the union coverage ratchet.
# (The bespoke check-e2e-coverage.ts was removed in b644581 when this repo
# migrated coverage gating to org-hooks; don't reintroduce it.)
set -euo pipefail
cd "$(dirname "$0")/.."

npm install
npx playwright install chromium

npm run --silent build:packages
npm run --silent build:admin
npm run --silent build:site
npm run test:e2e
