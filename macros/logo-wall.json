{
  "description": "A row of logos, each linking out",
  "defaults": {
    "title": "Our sponsors",
    "logos": [
      { "image": "", "href": "" },
      { "image": "", "href": "" },
      { "image": "", "href": "" },
      { "image": "", "href": "" }
    ]
  },
  "fieldSchema": {
    "title": { "label": "Heading", "type": "text" },
    "logos": {
      "label": "Logos",
      "type": "list",
      "item": {
        "image": { "label": "Logo", "type": "image" },
        "href": { "label": "Link", "type": "link" }
      }
    }
  },
  "tree": {
    "type": "grid",
    "slots": { "cols": 1, "band": true, "theme": "light", "edge": "straight" },
    "children": [
      { "type": "text", "markdown": "## {{title}}" },
      {
        "type": "grid",
        "slots": { "cols": 4, "min": "narrow", "align": "center", "each": "logos" },
        "children": [{ "type": "figure", "slots": { "ids": "{{image}}", "href": "{{href}}" } }]
      }
    ]
  }
}
