{
  "description": "A row of logos, each linking out",
  "defaults": {
    "title": "Our sponsors",
    "logos": [
      { "image": "", "href": "" },
      { "image": "", "href": "" },
      { "image": "", "href": "" },
      { "image": "", "href": "" }
    ],
    "theme": "light",
    "edge": "straight",
    "contentAlign": "center"
  },
  "fieldSchema": {
    "title": { "label": "Heading", "type": "text" },
    "logos": {
      "label": "Logos",
      "type": "list",
      "item": {
        "image": { "label": "Logo", "type": "image" },
        "href": { "label": "Link", "type": "link" }
      }
    },
    "theme": {
      "label": "Background",
      "type": "select",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "light-bold", "label": "Light bold" },
        { "value": "dark", "label": "Dark" },
        { "value": "dark-bold", "label": "Dark bold" }
      ]
    },
    "edge": {
      "label": "Bottom edge",
      "type": "select",
      "options": [
        { "value": "straight", "label": "Straight" },
        { "value": "wave", "label": "Wave" }
      ]
    },
    "contentAlign": {
      "label": "Alignment",
      "type": "select",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    }
  },
  "tree": {
    "type": "grid",
    "slots": { "cols": 1, "band": true, "theme": "{{theme}}", "edge": "{{edge}}" },
    "children": [
      { "type": "text", "markdown": "## {{title}}" },
      {
        "type": "grid",
        "slots": { "cols": 4, "min": "narrow", "align": "{{contentAlign}}", "each": "logos" },
        "children": [{ "type": "figure", "slots": { "ids": "{{image}}", "href": "{{href}}" } }]
      }
    ]
  }
}
