{
  "description": "A headline band with text, a button and an optional image",
  "defaults": {
    "heading": "Welcome",
    "text": "A line or two about this site.",
    "ctaLabel": "Join",
    "ctaHref": "/join",
    "image": ""
  },
  "fieldSchema": {
    "heading": { "label": "Heading", "type": "text" },
    "text": { "label": "Text", "type": "markdown" },
    "ctaLabel": { "label": "Button label", "type": "text" },
    "ctaHref": { "label": "Button link", "type": "link" },
    "image": { "label": "Image", "type": "image" }
  },
  "tree": {
    "type": "grid",
    "slots": { "cols": 1, "band": true, "theme": "dark", "edge": "wave" },
    "children": [
      {
        "type": "grid",
        "slots": { "cols": 2, "widths": "3 2", "align": "center" },
        "children": [
          {
            "type": "grid",
            "slots": { "cols": 1 },
            "children": [
              { "type": "text", "markdown": "# {{heading}}\n\n{{text}}" },
              { "type": "button", "slots": { "label": "{{ctaLabel}}", "href": "{{ctaHref}}", "variant": "primary", "size": "large" } }
            ]
          },
          { "type": "figure", "slots": { "ids": "{{image}}", "mask": "rounded" } }
        ]
      }
    ]
  }
}
