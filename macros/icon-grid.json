{
  "description": "A grid of small images with captions",
  "defaults": {
    "title": "What we offer",
    "items": [
      { "image": "", "caption": "First item" },
      { "image": "", "caption": "Second item" },
      { "image": "", "caption": "Third item" },
      { "image": "", "caption": "Fourth item" }
    ],
    "theme": "light",
    "edge": "straight",
    "mask": "none",
    "contentAlign": "center"
  },
  "fieldSchema": {
    "title": { "label": "Heading", "type": "text" },
    "items": {
      "label": "Items",
      "type": "list",
      "item": {
        "image": { "label": "Image", "type": "image" },
        "caption": { "label": "Caption", "type": "text" }
      }
    },
    "theme": {
      "label": "Background",
      "type": "select",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "light-bold", "label": "Light bold" },
        { "value": "dark", "label": "Dark" },
        { "value": "dark-bold", "label": "Dark bold" }
      ]
    },
    "edge": {
      "label": "Bottom edge",
      "type": "select",
      "options": [
        { "value": "straight", "label": "Straight" },
        { "value": "wave", "label": "Wave" }
      ]
    },
    "mask": {
      "label": "Image shape",
      "type": "select",
      "options": [
        { "value": "none", "label": "Square" },
        { "value": "circle", "label": "Circle" },
        { "value": "rounded", "label": "Rounded" }
      ]
    },
    "contentAlign": {
      "label": "Alignment",
      "type": "select",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    }
  },
  "tree": {
    "type": "grid",
    "slots": { "cols": 1, "band": true, "theme": "{{theme}}", "edge": "{{edge}}" },
    "children": [
      { "type": "text", "markdown": "## {{title}}" },
      {
        "type": "grid",
        "slots": { "cols": 4, "min": "narrow", "align": "{{contentAlign}}", "each": "items" },
        "children": [
          {
            "type": "grid",
            "slots": { "cols": 1 },
            "children": [
              { "type": "figure", "slots": { "ids": "{{image}}", "mask": "{{mask}}" } },
              { "type": "text", "markdown": "{{caption}}" }
            ]
          }
        ]
      }
    ]
  }
}
