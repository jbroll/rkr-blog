{
  "description": "A band holding a scrolling line of text",
  "defaults": {
    "text": "Announcement text",
    "image": "",
    "theme": "dark-bold",
    "edge": "straight"
  },
  "fieldSchema": {
    "text": { "label": "Scrolling text", "type": "text" },
    "image": { "label": "Background image", "type": "image" },
    "theme": {
      "label": "Background",
      "type": "select",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "light-bold", "label": "Light bold" },
        { "value": "dark", "label": "Dark" },
        { "value": "dark-bold", "label": "Dark bold" }
      ]
    },
    "edge": {
      "label": "Bottom edge",
      "type": "select",
      "options": [
        { "value": "straight", "label": "Straight" },
        { "value": "wave", "label": "Wave" }
      ]
    }
  },
  "tree": {
    "type": "grid",
    "slots": { "cols": 1, "band": true, "theme": "{{theme}}", "edge": "{{edge}}", "bg": "{{image}}" },
    "children": [{ "type": "marquee", "slots": { "text": "{{text}}" } }]
  }
}
