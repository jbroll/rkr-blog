{
  "description": "A band of cards, each with an image, title, text and link",
  "defaults": {
    "heading": "Latest",
    "intro": "",
    "cards": [
      { "image": "", "title": "Card one", "text": "A line about the first card.", "href": "/" },
      { "image": "", "title": "Card two", "text": "A line about the second card.", "href": "/" },
      { "image": "", "title": "Card three", "text": "A line about the third card.", "href": "/" }
    ],
    "button": "Read more",
    "cols": "3",
    "box": "true",
    "theme": "light",
    "edge": "straight",
    "mask": "none",
    "contentAlign": "start"
  },
  "fieldSchema": {
    "heading": { "label": "Heading", "type": "text" },
    "intro": { "label": "Intro", "type": "markdown" },
    "cards": {
      "label": "Cards",
      "type": "list",
      "item": {
        "image": { "label": "Image", "type": "image" },
        "title": { "label": "Title", "type": "text" },
        "text": { "label": "Text", "type": "markdown" },
        "href": { "label": "Link", "type": "link" },
        "button": { "label": "Button text", "type": "text" }
      }
    },
    "button": { "label": "Button text", "type": "text" },
    "cols": {
      "label": "Columns",
      "type": "select",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ]
    },
    "box": {
      "label": "Card style",
      "type": "select",
      "options": [
        { "value": "true", "label": "Panel" },
        { "value": "", "label": "None" }
      ]
    },
    "theme": {
      "label": "Background",
      "type": "select",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "light-bold", "label": "Light bold" },
        { "value": "dark", "label": "Dark" },
        { "value": "dark-bold", "label": "Dark bold" }
      ]
    },
    "edge": {
      "label": "Bottom edge",
      "type": "select",
      "options": [
        { "value": "straight", "label": "Straight" },
        { "value": "wave", "label": "Wave" }
      ]
    },
    "mask": {
      "label": "Image shape",
      "type": "select",
      "options": [
        { "value": "none", "label": "Square" },
        { "value": "circle", "label": "Circle" },
        { "value": "rounded", "label": "Rounded" }
      ]
    },
    "contentAlign": {
      "label": "Alignment",
      "type": "select",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    }
  },
  "tree": {
    "type": "grid",
    "slots": { "cols": 1, "band": true, "theme": "{{theme}}", "edge": "{{edge}}" },
    "children": [
      { "type": "text", "markdown": "## {{heading}}\n\n{{intro}}" },
      {
        "type": "grid",
        "slots": { "cols": "{{cols}}", "min": "narrow", "align": "{{contentAlign}}", "each": "cards" },
        "children": [
          {
            "type": "grid",
            "slots": { "cols": 1, "box": "{{box}}" },
            "children": [
              { "type": "figure", "slots": { "ids": "{{image}}", "href": "{{href}}", "mask": "{{mask}}" } },
              { "type": "text", "markdown": "### {{title}}\n\n{{text}}" },
              { "type": "button", "slots": { "label": "{{button}}", "href": "{{href}}", "variant": "secondary" } }
            ]
          }
        ]
      }
    ]
  }
}
