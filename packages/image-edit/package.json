{
  "name": "@rkr/image-edit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "development": "./src/core/index.ts",
      "default": "./dist/core/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "development": "./src/canvas/index.ts",
      "default": "./dist/canvas/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.core.json && tsc -p tsconfig.canvas.json",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.canvas.json"
  },
  "dependencies": {
    "cropperjs": "^1.6.2"
  }
}
