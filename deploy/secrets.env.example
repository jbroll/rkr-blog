# Template for a site's secrets file. One file per site.
#
# Non-secret config (SITE_ROOT, PUBLIC_BASE_URL, SPAM_*, SMTP_PORT…) lives
# in deploy/sites/<site>.env (committed to git). This file holds only secrets.
# Secrets win on collision, so a stray copy of one of those keys here
# silently overrides the site env; the build hook rejects the ones it can.
#
# Instructions:
#   cp deploy/secrets.env.example deploy/secrets/<site>.secrets.env
#   # fill in values below
#   DEPLOY_SH_CONF=deploy/sites/<site>.conf ~/src/deploy.sh/deploy.sh init .
#
# deploy/secrets/ is gitignored. Never commit these files.

# Google OAuth app credentials (https://console.cloud.google.com/apis/credentials).
# One client per host — do not share a client between sites.
# Authorised redirect URI: https://<admin-domain>/admin/auth/google/callback
# (<admin-domain> is ADMIN_BASE_URL's host, which defaults to the site domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bearer token for the /admin API. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Token for the Ollama proxy (see deploy/sites/<site>.env for OLLAMA_BASE_URL).
OLLAMA_TOKEN=

# SMTP credentials for comment email notifications (optional).
# SMTP_PORT and other non-secret SMTP settings live in deploy/sites/<site>.env.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO=
