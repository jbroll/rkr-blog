node_modules/

# Browser bundle build artifacts (built from src/admin/ + src/site/ via tsc -p tsconfig.browser.json)
static/admin/
static/site/

# Workspace package/app build artifacts
packages/*/dist/
apps/*/dist/
# Built at the app root so its service-worker scope covers start_url.
apps/image-pwa/sw.js
apps/image-pwa/sw.js.map

# c8 coverage output (test:coverage / test:coverage:report)
coverage/

# Tier-2 manifests written locally by ci/before-test-push
ci/.changed-files
ci/.source-tree
.nyc_output/
*.log
.DS_Store
.env
.env.*
!.env.example

# Operator-only credentials (never tracked). secret.env holds the
# ADMIN_TOKEN for the remote demo target; sourced by scripts/reseed-* etc.
secret.env
*.secret.env
# Deployment secrets — copy secrets.env.example → secrets.env and fill in
secrets.env
# Per-site deployment secrets — one file per site, never tracked
deploy/secrets/

# Local site root for dev (per §8: data lives outside repo, but in case anyone points SITE_ROOT inside)
/site/
/var/

# Editor / OS noise
*.swp
.idea/
.vscode/

# Playwright artifacts
/test-results/
/playwright-report/
/playwright/.cache/

# BrowserStack SDK auto-generated files
/log/
test/browserstackSetupConfig.json

# lefthook local overrides (machine-specific paths)
lefthook-local.yml

# agent worktrees (harness-managed, never tracked)
.claude/worktrees/

# Playwright MCP scratch
.playwright-mcp/
